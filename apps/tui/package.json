{
  "name": "@x1shell/tui",
  "version": "0.0.0-alpha.1",
  "description": "Bun-hosted OpenTUI client for X1Shell",
  "license": "MIT",
  "bin": {
    "x1shell": "./bin/x1shell.js"
  },
  "files": [
    "README.md",
    "bin",
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run src/index.tsx",
    "dev:headless": "X1SHELL_HEADLESS=1 bun run src/index.tsx",
    "build": "bun run --filter t3 build && tsdown && node scripts/copy-server-dist.mjs",
    "start": "bun dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --root ."
  },
  "dependencies": {
    "@opentui/core": "0.1.103",
    "@opentui/react": "0.1.103",
    "react": "^19.0.0",
    "web-tree-sitter": "0.25.10",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@t3tools/client-runtime": "workspace:*",
    "@t3tools/contracts": "workspace:*",
    "@t3tools/shared": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "^19.0.0",
    "@types/ws": "^8.18.1",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "optionalDependencies": {
    "@opentui/core-darwin-arm64": "0.1.103",
    "@opentui/core-darwin-x64": "0.1.103",
    "@opentui/core-linux-arm64": "0.1.103",
    "@opentui/core-linux-x64": "0.1.103",
    "@opentui/core-win32-arm64": "0.1.103",
    "@opentui/core-win32-x64": "0.1.103"
  },
  "engines": {
    "bun": "^1.3.11"
  }
}
